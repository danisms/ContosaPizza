@ContosaPizza_HostAddress = http://localhost:5175

GET {{ContosaPizza_HostAddress}}/weatherforecast/
Accept: application/json

# PIZZA REQUESTS
# [GET]
###
GET {{ContosaPizza_HostAddress}}/pizza/
Accept: application/json

###
GET {{ContosaPizza_HostAddress}}/pizza/1
Accept: application/json

###
GET {{ContosaPizza_HostAddress}}/pizza/100
Accept: application/json

# [POST] - create
###
POST {{ContosaPizza_HostAddress}}/pizza/
Content-Type: application/json

{
    "name": "Hawaii",
    "isGlutenFree": false
}

# [PUT] - Update
###
PUT {{ContosaPizza_HostAddress}}/pizza/4
Content-Type: application/json

{
    "id": 4,
    "name": "Hawaiian",
    "isGlutenFree": false
}

# [DELETE] - Remove
###
DELETE {{ContosaPizza_HostAddress}}/pizza/4
